# Telegram (required for live posting; leave empty / set DRY_RUN=1 to print only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# 1 = print signals to stdout instead of posting (also forced if tokens missing)
DRY_RUN=1

# Symbols (comma-separated Binance USDT-M futures pairs)
SYMBOLS=BTCUSDT,ETHUSDT

# Candle interval and leverage
# Live default: 15m. Optional experimental alt: 1h (INTERVAL=1h or --interval 1h).
INTERVAL=15m
LEVERAGE=10
KLINE_LIMIT=200

# Base direction: EMA + RSI
EMA_FAST=9
EMA_SLOW=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30

# --- Confluence filters (1/0) — Fib+MACD+ATR on; ADX off by default ---
FILTER_FIB=1
FILTER_MACD=1
FILTER_ATR=1
FILTER_ADX=0

# Fibonacci swing lookback (bars) and proximity tolerance
# Tolerance = max(price * FIB_TOL_PCT/100, ATR * FIB_TOL_ATR)
# FIB_LEVELS: confluence ratios (default 0.382,0.5,0.618 — prior best)
FIB_LOOKBACK=80
FIB_TOL_PCT=0.25
FIB_TOL_ATR=0.5
FIB_LEVELS=0.382,0.5,0.618

# MACD (standard 12/26/9)
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9

# ATR volatility gate (ATR% = ATR/price*100)
ATR_PERIOD=14
ATR_MIN_PCT=0.15
ATR_MAX_PCT=0

# ADX trend-strength gate (Wilder ADX; FILTER_ADX=0 by default; ADX_MIN kept for enable)
ADX_PERIOD=14
ADX_MIN=25

# Entry ladder: 4 % offsets from reference (LONG uses as-is; SHORT mirrors)
ENTRY_OFFSETS_PCT=0,-0.3,-0.6,-1.0

# Take-profit % targets from reference (5 values)
TP_TARGETS_PCT=0.5,1.0,1.5,2.5,4.0

# Stop-loss % beyond the farthest entry of the ladder
SL_BEYOND_LADDER_PCT=0.5

# Cooldown hours per symbol/side (avoids spam)
COOLDOWN_HOURS=5

# Seconds between scans in continuous mode
POLL_INTERVAL_SEC=60

# Binance USDT-M futures public API base (no keys needed).
# If you get HTTP 451 (geo-block), try: https://www.binance.com
# The client also auto-falls back to www.binance.com.
BINANCE_FUTURES_BASE=https://fapi.binance.com
